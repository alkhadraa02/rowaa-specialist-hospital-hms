# Copy to .env — the seed script reads these values.
DATABASE_URL="file:./dev.db"

# Seeded administrator (HMS role: admin). Change before any real use.
ADMIN_EMAIL="admin@rowaa.example"
ADMIN_PASSWORD="Rowaa-Admin-2026!"

# Password given to the other seeded demo staff accounts (doctor, nurse, reception, lab, radiology, pharmacy, billing).
DEMO_STAFF_PASSWORD="Rowaa-Staff-2026!"

# Password of the demo patient portal account (national ID is shown on the portal login page).
DEMO_PATIENT_PASSWORD="Rowaa-Patient-2026!"

# Set to "true" when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE="false"

# Public base URL used for canonical links, sitemap and llms.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3120"

# Optional: real LLM provider (OpenAI-compatible). Leave empty to use the built-in mock provider.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
